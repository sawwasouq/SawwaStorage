// ---------- customer lookup (autofill from previous orders) ----------
function handleCustomerLookup(){
  const phoneEl = document.getElementById('cPhone');
  const box = document.getElementById('customerSuggestion');
  if(!phoneEl || !box) return;
  const phone = phoneEl.value.trim();
  const digits = phone.replace(/\D/g,'');
  if(digits.length<6){ box.innerHTML=''; window._customerSuggestion=null; return; }
  const match = [...ORDERS]
    .filter(o=>o.phone && o.phone.replace(/\D/g,'')===digits)
    .sort((a,b)=>b.createdAt-a.createdAt)[0];
  if(match){
    window._customerSuggestion = match;
    box.innerHTML = `<div style="background:#EFE5CB; border-radius:8px; padding:9px 12px; font-size:12.5px; margin:-6px 0 12px; display:flex; justify-content:space-between; align-items:center; gap:8px;">
