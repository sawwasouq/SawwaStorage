async function confirmSettle(){
  const prev = computeSettlementPreview();
  const now = Date.now();
  FINANCE.capitalBalance += prev.reinvestAmount;
  FINANCE.reserveBalance += prev.reserveAmount;
  if(prev.reserveAmount !== 0){
    RESERVE_LOG.push({id:uid('res'), type: prev.reserveAmount>=0?'add':'use', amount:prev.reserveAmount, note:'تصفية أرباح', createdAt:now});
  }
  if(prev.reinvestAmount !== 0){
    CAPITAL_LOG.push({id:uid('cap'), type:'settlement', amount:prev.reinvestAmount, note:'تصفية أرباح', createdAt:now});
  }
  prev.partnerBreakdown.forEach(pb=>{
    const p = PARTNERS.find(x=>x.id===pb.partnerId);
    if(p) p.dueBalance = (p.dueBalance||0) + pb.amount;
  });
  SETTLEMENTS.push({
    id: uid('stl'), createdAt: now,
    periodFrom: FINANCE.lastSettlementAt || 0, periodTo: now,
    totalRevenue: prev.stats.totalRevenue, cogs: prev.stats.cogs, expensesTotal: prev.stats.expensesTotal,
    netProfit: prev.stats.netProfit, reinvestAmount: prev.reinvestAmount, ownerAmount: prev.ownerAmount,
    reserveAmount: prev.reserveAmount, partnerBreakdown: prev.partnerBreakdown
  });
  FINANCE.lastSettlementAt = now;
  await saveFinanceConfig();
  await saveCapitalLog();
  await saveReserveLog();
  await savePartners();
  await saveSettlements();
  closeModal();
  toast('تمت تصفية الأرباح بنجاح 🎉');
  render();
}

// ---------- init ----------
loadAll();
</script>
</body>
</html>
