function buildExpensesListHtml(){
  if(EXPENSES.length===0) return `<div class="empty-mini">ما في مصاريف مسجلة بعد</div>`;
  const sorted = [...EXPENSES].sort((a,b)=>b.createdAt-a.createdAt);
  const rows = sorted.map(e=>`
    <div class="list-row">
      <div class="lr-main">
        <span class="cat-badge">${escapeHtml(e.category)}</span>
        <div class="lr-title">${escapeHtml(e.title)}</div>
        <div class="lr-sub">${formatDate(e.createdAt)}${e.note ? ' · '+escapeHtml(e.note) : ''}</div>
      </div>
      <div class="lr-amount neg">-${money(e.amount)} د.أ</div>
      <div class="lr-actions"><button class="icon-btn" onclick="deleteExpense('${e.id}')" title="حذف">🗑</button></div>
    </div>
  `).join('');
  const total = EXPENSES.reduce((s,e)=>s+e.amount,0);
  return rows + `<div class="list-row" style="border-bottom:none; padding-top:12px;">
    <div class="lr-main"><div class="lr-title">إجمالي المصاريف</div></div>
    <div class="lr-amount neg">-${money(total)} د.أ</div>
  </div>`;
}

function buildCapitalLogHtml(){
  if(CAPITAL_LOG.length===0) return `<div class="empty-mini">ما في حركات رأس مال يدوية بعد</div>`;
  const sorted = [...CAPITAL_LOG].sort((a,b)=>b.createdAt-a.createdAt).slice(0,10);
  return sorted.map(c=>{
    const isPositive = c.type==='injection' || c.type==='settlement';
    const label = c.type==='injection' ? 'إيداع رأس مال' : (c.type==='withdrawal' ? 'سحب رأس مال' : 'ربح مُعاد استثماره (تصفية)');
    return `<div class="list-row">
      <div class="lr-main">
        <div class="lr-title">${label}</div>
        <div class="lr-sub">${formatDate(c.createdAt)}${c.note ? ' · '+escapeHtml(c.note) : ''}</div>
      </div>
      <div class="lr-amount ${isPositive?'pos':'neg'}">${isPositive?'+':'-'}${money(Math.abs(c.amount))} د.أ</div>
    </div>`;
  }).join('');
}

function buildSplitBarHtml(){
