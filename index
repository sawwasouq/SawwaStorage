  if(price<0 || isNaN(price)){ toast('سعر البيع غير صحيح'); return; }
  if(wholesalePrice<0 || isNaN(wholesalePrice)){ toast('سعر الجملة غير صحيح'); return; }

  if(productId){
    const p = PRODUCTS.find(x=>x.id===productId);
