async function saveShippingCompanyForm(companyId){
  const name = document.getElementById('scName').value.trim();
  const phone = document.getElementById('scPhone').value.trim();
  const note = document.getElementById('scNote').value.trim();
  if(!name){ toast('اكتب اسم الشركة'); return; }
  if(!phone){ toast('اكتب رقم هاتف الشركة'); return; }
  if(companyId){
    const c = SHIPPING_COMPANIES.find(x=>x.id===companyId);
    c.name=name; c.phone=phone; c.note=note;
  } else {
    SHIPPING_COMPANIES.push({id:uid('ship'), name, phone, note, createdAt:Date.now()});
  }
  await saveShippingCompanies();
  toast('تم الحفظ');
  openShippingCompaniesModal();
}

async function deleteShippingCompany(companyId){
  if(!confirm('حذف شركة الشحن هاي؟ الطلبات القديمة المرتبطة فيها بتضل محتفظة باسمها.')) return;
  SHIPPING_COMPANIES = SHIPPING_COMPANIES.filter(c=>c.id!==companyId);
  await saveShippingCompanies();
  toast('تم الحذف');
  openShippingCompaniesModal();
}

