  if(partnerId){
    const p = PARTNERS.find(x=>x.id===partnerId);
    p.name=name; p.sharePct=sharePct;
  } else {
    PARTNERS.push({id:uid('ptn'), name, sharePct, dueBalance:0});
  }
  const total = PARTNERS.reduce((s,p)=>s+p.sharePct,0);
  await savePartners();
  closeModal();
  if(Math.round(total)!==100) toast(`تنبيه: مجموع نسب الشركاء الآن ${total}% (المفروض يكون 100%)`);
  else toast('تم الحفظ');
  render();
}

