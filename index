<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مخزون سوّي سوق</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=JetBrains+Mono:wght@500;700&display=swap');

:root{
  --paper:#EDE5D3;
  --card:#FBF7EE;
  --ink:#2B241A;
  --ink-soft:#6B5F4C;
  --line:#D9CBA9;
  --teal:#1F6F5C;
  --teal-dark:#164F42;
  --amber:#B9822F;
  --rust:#B0532A;
  --green:#3E7C4A;
  --red:#A6402F;
  --shadow: 0 1px 0 rgba(43,36,26,.06);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(circle at 1px 1px, rgba(43,36,26,.045) 1px, transparent 0) 0 0/16px 16px,
    var(--paper);
  color:var(--ink);
  font-family:'Tajawal', 'Segoe UI', Tahoma, sans-serif;
  min-height:100vh;
  padding-bottom:100px;
}
.mono{font-family:'JetBrains Mono', monospace;}

/* ===== Header ===== */
header{
  background:var(--teal-dark);
  color:#F3EEDF;
  padding:18px 20px 16px;
  position:sticky; top:0; z-index:30;
  box-shadow:0 3px 10px rgba(0,0,0,.15);
}
.header-inner{display:flex; align-items:center; justify-content:space-between; max-width:1100px; margin:0 auto;}
.brand{display:flex; align-items:center; gap:10px;}
.brand-mark{
  width:38px;height:38px;border-radius:8px;
  background:var(--amber);
  display:flex;align-items:center;justify-content:center;
  font-weight:900;color:var(--teal-dark);font-size:18px;
  transform:rotate(-4deg);
  box-shadow:2px 2px 0 rgba(0,0,0,.2);
}
.brand-text h1{margin:0;font-size:19px;font-weight:900;letter-spacing:.3px;}
.season-switch{
  margin-top:2px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18);
  color:#F3EEDF; font-family:'JetBrains Mono',monospace; font-size:11.5px; letter-spacing:.3px;
  padding:3px 10px; border-radius:20px; cursor:pointer; transition:.15s;
}
.season-switch:hover{background:rgba(255,255,255,.18);}

.tabs{display:flex; gap:6px; background:rgba(255,255,255,.08); padding:4px; border-radius:10px;}
.tab-btn{
  background:transparent;border:none;color:#DDE7DF;padding:9px 16px;border-radius:7px;
  font-family:inherit;font-weight:700;font-size:14.5px;cursor:pointer;transition:.15s;
}
.tab-btn.active{background:var(--amber); color:var(--teal-dark);}
.tab-count{
  display:inline-block;margin-inline-start:6px;background:rgba(0,0,0,.18);
  border-radius:20px;padding:1px 7px;font-size:11px;font-family:'JetBrains Mono',monospace;
}
.tab-btn.active .tab-count{background:rgba(0,0,0,.15);}

main{max-width:1100px; margin:0 auto; padding:22px 18px;}

/* ===== Toolbar ===== */
.toolbar{display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:18px; flex-wrap:wrap;}
.toolbar h2{margin:0;font-size:20px; font-weight:900;}
.toolbar .sub{color:var(--ink-soft); font-size:13px; margin-top:2px;}

.btn{
  border:none;border-radius:9px;padding:10px 16px;font-family:inherit;font-weight:700;
  font-size:14px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:.15s;
  white-space:nowrap;
}
.btn:active{transform:scale(.97);}
.btn-primary{background:var(--teal); color:#fff;}
.btn-primary:hover{background:var(--teal-dark);}
.btn-amber{background:var(--amber); color:#2B241A;}
.btn-amber:hover{filter:brightness(1.06);}
.btn-outline{background:transparent; border:1.5px solid var(--line); color:var(--ink);}
.btn-outline:hover{border-color:var(--teal); color:var(--teal);}
.btn-ghost{background:transparent; color:var(--ink-soft); padding:6px 10px;}
.btn-danger{background:transparent;color:var(--red);border:1.5px solid #E3C9BE;}
.btn:disabled{opacity:.4; cursor:not-allowed;}
.btn-sm{padding:7px 11px; font-size:12.5px; border-radius:7px;}
.btn-block{width:100%; justify-content:center;}

/* ===== Product grid ===== */
.grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(210px,1fr)); gap:16px;}
.card{
  background:var(--card); border:1px solid var(--line); border-radius:12px; overflow:hidden;
  box-shadow:var(--shadow); position:relative; display:flex; flex-direction:column;
}
.card-img{
  height:140px; background:#E4DAC3 center/cover no-repeat; position:relative;
  display:flex;align-items:center;justify-content:center; color:#B7A986; font-size:12px;
}
.card-img.empty::after{content:"لا توجد صورة";}
.stock-tag{
  position:absolute; top:8px; left:8px; background:rgba(43,36,26,.82); color:#F3EEDF;
  font-family:'JetBrains Mono',monospace; font-size:11.5px; padding:3px 9px; border-radius:20px;
}
.stock-tag.zero{background:var(--red);}
.stock-tag.low{background:var(--rust);}
.card-body{padding:12px 13px 13px; display:flex; flex-direction:column; gap:6px; flex:1;}
.card-body h3{margin:0; font-size:15px; font-weight:700; line-height:1.3;}
.price{color:var(--teal-dark); font-weight:900; font-family:'JetBrains Mono',monospace; font-size:15px;}
.card-actions{display:flex; gap:6px; margin-top:auto; padding-top:6px;}

.empty-state{
  text-align:center; padding:60px 20px; color:var(--ink-soft);
  border:2px dashed var(--line); border-radius:14px; background:rgba(255,255,255,.4);
}
.empty-state .big{font-size:38px; margin-bottom:8px;}

/* ===== Orders ===== */
.order-list{display:flex; flex-direction:column; gap:12px;}
.order-card{
  background:var(--card); border:1px solid var(--line); border-radius:12px; padding:14px 16px;
  box-shadow:var(--shadow);
}
.order-top{display:flex; justify-content:space-between; align-items:flex-start; gap:10px; flex-wrap:wrap;}
.order-id{font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--ink-soft);}
.order-customer{font-weight:700; font-size:14.5px; margin-top:2px;}
.badge{
  font-size:12px; font-weight:700; padding:5px 12px; border-radius:20px; white-space:nowrap;
  display:inline-flex; align-items:center; gap:5px;
}
.badge::before{content:""; width:7px;height:7px;border-radius:50%; background:currentColor;}
.badge-warehouse{background:#F1E4C6; color:var(--amber);}
.badge-delivering{background:#F3DCC9; color:var(--rust);}
.badge-done{background:#DCEBDD; color:var(--green);}
.badge-cancelled{background:#F1DAD3; color:var(--red);}

.order-items{margin:10px 0; border-top:1px dashed var(--line); border-bottom:1px dashed var(--line); padding:8px 0;}
.order-item-row{display:flex; justify-content:space-between; font-size:13.5px; padding:3px 0; color:var(--ink);}
.order-item-row span:last-child{font-family:'JetBrains Mono',monospace; color:var(--ink-soft);}
.order-total{display:flex; justify-content:space-between; font-weight:900; font-size:15px; margin-top:4px;}
.order-actions{display:flex; gap:8px; justify-content:flex-end; margin-top:10px; flex-wrap:wrap;}

/* ===== Cart floating ===== */
.cart-fab{
  position:fixed; bottom:22px; left:22px; z-index:40;
  background:var(--amber); color:var(--teal-dark); border:none;
  padding:14px 20px; border-radius:30px; font-family:inherit; font-weight:900; font-size:15px;
  box-shadow:0 6px 18px rgba(0,0,0,.25); cursor:pointer; display:flex; align-items:center; gap:8px;
}
.cart-fab .n{background:var(--teal-dark); color:#fff; border-radius:50%; width:22px;height:22px;
  display:flex;align-items:center;justify-content:center; font-size:12px;}

/* ===== Modal ===== */
.overlay{
  position:fixed; inset:0; background:rgba(20,16,10,.5); z-index:50;
  display:flex; align-items:center; justify-content:center; padding:16px;
}
.modal{
  background:var(--paper); border-radius:16px; width:100%; max-width:460px;
  max-height:88vh; overflow-y:auto; padding:22px; border:1px solid var(--line);
  box-shadow:0 20px 50px rgba(0,0,0,.3);
}
.modal h2{margin:0 0 16px; font-size:19px; font-weight:900;}
.field{margin-bottom:14px;}
.field label{display:block; font-size:13px; font-weight:700; margin-bottom:5px; color:var(--ink-soft);}
.field input, .field textarea{
  width:100%; padding:10px 12px; border-radius:8px; border:1.5px solid var(--line);
  font-family:inherit; font-size:14px; background:var(--card); color:var(--ink);
}
.field input:focus, .field textarea:focus{outline:2px solid var(--teal); outline-offset:1px; border-color:var(--teal);}
.row2{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
.img-upload{
  border:2px dashed var(--line); border-radius:10px; padding:14px; text-align:center;
  cursor:pointer; color:var(--ink-soft); font-size:13px; background:var(--card);
  display:flex; flex-direction:column; align-items:center; gap:6px;
}
.img-upload img{max-height:110px; border-radius:8px;}
.modal-actions{display:flex; gap:10px; margin-top:6px;}

/* cart modal items */
.cart-row{display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--line);}
.cart-row img, .cart-row .ph{width:44px;height:44px;border-radius:7px;object-fit:cover; background:#E4DAC3; flex-shrink:0;}
.cart-row .info{flex:1; min-width:0;}
.cart-row .info h4{margin:0; font-size:13.5px; font-weight:700;}
.cart-row .info .p{font-size:12px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace;}
.qty-ctrl{display:flex; align-items:center; gap:6px;}
.qty-ctrl button{
  width:26px;height:26px;border-radius:6px;border:1px solid var(--line); background:var(--card);
  cursor:pointer; font-weight:900; color:var(--teal); font-size:14px;
}
.qty-ctrl span{min-width:18px; text-align:center; font-family:'JetBrains Mono',monospace; font-weight:700;}
.cart-empty{text-align:center; padding:30px 10px; color:var(--ink-soft);}
.cart-total{display:flex;justify-content:space-between;font-weight:900;font-size:17px;margin:14px 0;
  padding-top:12px; border-top:2px solid var(--ink);}

/* ===== Stats & filters ===== */
.stats-bar{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px;}
.stat-card{
  background:var(--card); border:1px solid var(--line); border-radius:10px;
  padding:10px 16px; min-width:120px; box-shadow:var(--shadow);
}
.stat-card .n{font-family:'JetBrains Mono',monospace; font-weight:900; font-size:19px; color:var(--teal-dark);}
.stat-card .l{font-size:12px; color:var(--ink-soft); margin-top:1px;}
.stat-card.warn .n{color:var(--rust);}

.search-box{
  position:relative; min-width:200px; flex:1; max-width:280px;
}
.search-box input{
  width:100%; padding:9px 13px 9px 34px; border-radius:9px; border:1.5px solid var(--line);
  font-family:inherit; font-size:13.5px; background:var(--card); color:var(--ink);
}
.search-box input:focus{outline:2px solid var(--teal); outline-offset:1px; border-color:var(--teal);}
.search-box::before{
  content:"🔍"; position:absolute; left:11px; top:50%; transform:translateY(-50%); font-size:12px; opacity:.6;
}

.filter-chips{display:flex; gap:7px; flex-wrap:wrap; margin-bottom:16px;}
.chip{
  border:1.5px solid var(--line); background:var(--card); color:var(--ink-soft);
  padding:7px 14px; border-radius:20px; font-family:inherit; font-size:13px; font-weight:700;
  cursor:pointer; transition:.15s;
}
.chip.active{background:var(--teal); border-color:var(--teal); color:#fff;}
.chip .c{font-family:'JetBrains Mono',monospace; opacity:.85; margin-inline-start:4px;}

.order-note{font-size:12.5px; color:var(--ink-soft); padding-top:6px;}
.icon-btn{
  background:transparent; border:1.5px solid var(--line); border-radius:7px; width:30px; height:30px;
  cursor:pointer; font-size:13px; color:var(--ink-soft); display:inline-flex; align-items:center; justify-content:center;
}
.icon-btn:hover{border-color:var(--teal); color:var(--teal);}

/* ===== Finance page ===== */
.select-field{
  width:100%; padding:10px 12px; border-radius:8px; border:1.5px solid var(--line);
  font-family:inherit; font-size:14px; background:var(--card); color:var(--ink);
}
.select-field:focus{outline:2px solid var(--teal); outline-offset:1px; border-color:var(--teal);}

.sale-section{margin-top:18px;}
.sale-section:first-child{margin-top:0;}
.sale-section-label{
  font-size:11.5px; font-weight:800; color:var(--teal-dark); text-transform:uppercase;
  letter-spacing:.6px; margin-bottom:8px; display:flex; align-items:center; gap:6px;
}
.sale-section-label .ic{font-size:13px;}

.cart-row{position:relative; padding-inline-start:0;}
.cart-row .line-total{font-family:'JetBrains Mono',monospace; font-weight:800; font-size:13.5px; color:var(--teal-dark); min-width:62px; text-align:left;}
.cart-row .remove-x{
  background:transparent; border:none; color:var(--ink-soft); font-size:15px; cursor:pointer;
  width:22px; height:22px; line-height:1; border-radius:5px; flex-shrink:0;
}
.cart-row .remove-x:hover{color:var(--red); background:#F1DAD3;}

.item-count-pill{
  background:var(--teal); color:#fff; font-family:'JetBrains Mono',monospace; font-size:11.5px;
  font-weight:800; padding:2px 9px; border-radius:20px; margin-inline-start:6px;
}

.receipt-box{
  background:var(--paper); border:1.5px dashed var(--line); border-radius:10px;
  padding:14px 16px; margin-top:4px;
}
.receipt-box .r-row{display:flex; justify-content:space-between; font-size:13.5px; padding:4px 0; color:var(--ink-soft);}
.receipt-box .r-row.grand{
  border-top:1.5px solid var(--ink); margin-top:6px; padding-top:10px;
  font-size:17px; font-weight:900; color:var(--ink);
}
.receipt-box .r-row.grand span:last-child{font-family:'JetBrains Mono',monospace; color:var(--teal-dark);}

.shipping-hint{
  font-size:12px; color:var(--ink-soft); margin-top:5px; display:flex; align-items:center; gap:5px; justify-content:space-between;
}
.shipping-hint a{color:var(--teal); font-weight:700; cursor:pointer;}

.fin-section{
  background:var(--card); border:1px solid var(--line); border-radius:14px;
  padding:18px 20px; margin-bottom:18px; box-shadow:var(--shadow);
}
.fin-section h3{margin:0 0 3px; font-size:16.5px; font-weight:900;}
.fin-section .fin-sub{font-size:12.5px; color:var(--ink-soft); margin-bottom:14px;}
.fin-section-head{display:flex; justify-content:space-between; align-items:flex-start; gap:10px; flex-wrap:wrap; margin-bottom:8px;}

.fin-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:10px; margin-bottom:6px;}
.fin-tile{border:1px solid var(--line); border-radius:10px; padding:12px 14px; background:#fff;}
.fin-tile .n{font-family:'JetBrains Mono',monospace; font-weight:900; font-size:18px; color:var(--teal-dark);}
.fin-tile .n.neg{color:var(--red);}
.fin-tile .l{font-size:11.5px; color:var(--ink-soft); margin-top:2px;}

.list-row{
  display:flex; align-items:center; justify-content:space-between; gap:10px;
  padding:10px 0; border-bottom:1px solid var(--line);
}
.list-row:last-child{border-bottom:none;}
.list-row .lr-main{flex:1; min-width:0;}
.list-row .lr-title{font-weight:700; font-size:13.5px;}
.list-row .lr-sub{font-size:11.5px; color:var(--ink-soft); margin-top:1px;}
.list-row .lr-amount{font-family:'JetBrains Mono',monospace; font-weight:800; font-size:14px; white-space:nowrap;}
.list-row .lr-amount.neg{color:var(--red);}
.list-row .lr-amount.pos{color:var(--green);}
.list-row .lr-actions{display:flex; gap:6px;}

.cat-badge{
  font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; background:#EFE5CB; color:var(--amber);
  display:inline-block; margin-bottom:2px;
}

.split-bar{display:flex; height:14px; border-radius:20px; overflow:hidden; margin:10px 0; border:1px solid var(--line);}
.split-bar .seg-reinvest{background:var(--teal);}
.split-bar .seg-owner{background:var(--amber);}
.split-bar .seg-reserve{background:var(--rust);}
.split-legend{display:flex; gap:14px; flex-wrap:wrap; font-size:12px; color:var(--ink-soft); margin-bottom:6px;}
.split-legend span{display:inline-flex; align-items:center; gap:5px;}
.split-legend .dot{width:9px;height:9px;border-radius:3px; display:inline-block;}

.empty-mini{text-align:center; padding:20px; color:var(--ink-soft); font-size:13px;}

.toast{
  position:fixed; bottom:24px; right:24px; background:var(--teal-dark); color:#F3EEDF;
  padding:12px 18px; border-radius:9px; font-weight:700; font-size:13.5px; z-index:60;
  box-shadow:0 8px 20px rgba(0,0,0,.25); animation:toastin .25s ease;
}
@keyframes toastin{from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);}}
.loading{text-align:center; padding:60px; color:var(--ink-soft);}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="brand">
      <div class="brand-mark">سق</div>
      <div class="brand-text">
        <h1>مخزون سوّي سوق</h1>
        <button class="season-switch" id="seasonSwitchBtn" onclick="openSeasonModal()">
          <span id="currentSeasonLabel">الموسم الأول</span> ▾
        </button>
      </div>
    </div>
    <div class="tabs">
      <button class="tab-btn active" id="tabProductsBtn" onclick="switchTab('products')">
        المنتجات <span class="tab-count" id="countProducts">0</span>
      </button>
      <button class="tab-btn" id="tabOrdersBtn" onclick="switchTab('orders')">
        الطلبات <span class="tab-count" id="countOrders">0</span>
      </button>
      <button class="tab-btn" id="tabFinanceBtn" onclick="switchTab('finance')">
        الحسابات
      </button>
    </div>
  </div>
</header>

<main>
  <div id="productsView">
    <div id="productsStats" class="stats-bar"></div>
    <div id="lowStockBanner"></div>
    <div class="toolbar">
      <div class="search-box">
        <input type="text" id="productSearch" placeholder="ابحث عن منتج بالاسم" oninput="handleProductSearch(this.value)">
      </div>
      <button class="btn btn-primary" onclick="openProductModal()">+ إضافة منتج</button>
    </div>
    <div id="productsGrid" class="grid"></div>
  </div>

  <div id="ordersView" style="display:none;">
    <div class="toolbar">
      <div>
        <h2>الطلبات</h2>
        <div class="sub">إدارة طلبات البيع وحالتها</div>
      </div>
      <button class="btn btn-outline btn-sm" onclick="openShippingCompaniesModal()">🚚 شركات الشحن</button>
    </div>
    <div id="ordersStats" class="stats-bar"></div>
    <div id="orderFilters" class="filter-chips"></div>
    <div id="ordersList" class="order-list"></div>
  </div>

  <div id="financeView" style="display:none;"></div>
</main>

<button class="cart-fab" id="cartFab" onclick="openCartModal()" style="display:none;">
  🛒 سلة البيع <span class="n" id="cartCount">0</span>
</button>

<div id="modalRoot"></div>
<input type="file" id="importBackupInput" accept="application/json" style="display:none" onchange="handleImportBackup(event)">

<script>
let PRODUCTS = [];
let ORDERS = [];
let CART = []; // {productId, qty}
let EXPENSES = [];
let PARTNERS = [];
let CAPITAL_LOG = [];
let RESERVE_LOG = [];
let PARTNER_PAYOUTS = [];
let SETTLEMENTS = [];
let FINANCE = null;
let RESTOCK_LOG = [];
let reportPeriod = 'today';
let currentTab = 'products';
let editingImageData = null;
let productSearchQuery = '';
let orderFilter = 'all';
let SEASONS = [];
let currentSeasonId = null;
let SHIPPING_COMPANIES = [];

function seasonKey(base){
  return base + '::' + currentSeasonId;
}

// ---------- storage ----------
async function loadAll(){
  try{
    const sc = await window.storage.get('shipping-companies', false);
    SHIPPING_COMPANIES = sc ? JSON.parse(sc.value) : [];
  }catch(e){ SHIPPING_COMPANIES = []; }

  let seasonsData = null;
  try{
    const s = await window.storage.get('seasons-list', false);
    seasonsData = s ? JSON.parse(s.value) : null;
  }catch(e){ seasonsData = null; }

  if(!seasonsData || seasonsData.length===0){
    // first time ever running this refactor: the user's existing data lives under
    // the old flat (un-scoped) keys. Treat all of it as "الموسم الأول" and migrate it.
    const season1 = {id:'season_1', name:'الموسم الأول', createdAt:Date.now()};
    SEASONS = [season1];
    currentSeasonId = season1.id;
    await loadLegacyFlatData(); // populates PRODUCTS, ORDERS, etc. from the old flat keys
    await saveSeasonsList();
    await saveAppSettings();
    await saveAllCurrentSeasonData(); // persist that same data under the new scoped keys
  } else {
    SEASONS = seasonsData;
    let settings = null;
    try{
      const st = await window.storage.get('app-settings', false);
      settings = st ? JSON.parse(st.value) : null;
    }catch(e){ settings = null; }
    currentSeasonId = (settings && settings.currentSeasonId && SEASONS.find(s=>s.id===settings.currentSeasonId))
      ? settings.currentSeasonId : SEASONS[0].id;
    await loadSeasonData(currentSeasonId);
  }
  render();
}

// Loads the old un-scoped keys (pre-season version of the app)
async function loadLegacyFlatData(){
