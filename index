function computeSettlementPreview(){
  const stats = computeStatsSince(FINANCE.lastSettlementAt || 0);
  const net = stats.netProfit;
  let reinvestAmount, ownerAmount, reserveAmount;
  if(net > 0){
    reinvestAmount = net * FINANCE.splitReinvestPct/100;
    ownerAmount = net * FINANCE.splitOwnerPct/100;
    reserveAmount = net - reinvestAmount - ownerAmount; // remainder absorbs rounding drift
  } else {
    // a loss period is absorbed entirely by capital; nothing to distribute
    reinvestAmount = net; ownerAmount = 0; reserveAmount = 0;
  }
  const partnerBreakdown = PARTNERS.map(p=>({
    partnerId:p.id, name:p.name, sharePct:p.sharePct, amount: ownerAmount * p.sharePct/100
  }));
  return {stats, reinvestAmount, ownerAmount, reserveAmount, partnerBreakdown};
}

