let allSeasonsSummaryCache = null;

async function computeAllSeasonsSummary(){
  const perSeason = [];
  for(const s of SEASONS){
    const sk = (base)=> base + '::' + s.id;
    let orders=[], expenses=[], products=[], finance=null;
    try{ const o = await window.storage.get(sk('orders-list'), false); orders = o ? JSON.parse(o.value) : []; }catch(e){}
    try{ const ex = await window.storage.get(sk('expenses-list'), false); expenses = ex ? JSON.parse(ex.value) : []; }catch(e){}
    try{ const p = await window.storage.get(sk('products-list'), false); products = p ? JSON.parse(p.value) : []; }catch(e){}
    try{ const fc = await window.storage.get(sk('finance-config'), false); finance = fc ? JSON.parse(fc.value) : null; }catch(e){}
    const stats = computeStatsForData(orders, expenses, 0);
    const inventoryCapital = products.reduce((sum,p)=>sum+p.qty*(p.wholesalePrice||0),0);
    const capitalBalance = finance ? (finance.capitalBalance||0) : 0;
    const reserveBalance = finance ? (finance.reserveBalance||0) : 0;
    perSeason.push({season:s, stats, inventoryCapital, capitalBalance, reserveBalance});
  }
  const totals = perSeason.reduce((acc,r)=>{
    acc.ordersCount += r.stats.ordersCount;
    acc.totalRevenue += r.stats.totalRevenue;
    acc.cogs += r.stats.cogs;
    acc.expensesTotal += r.stats.expensesTotal;
    acc.netProfit += r.stats.netProfit;
    acc.inventoryCapital += r.inventoryCapital;
    acc.capitalBalance += r.capitalBalance;
    acc.reserveBalance += r.reserveBalance;
    return acc;
  }, {ordersCount:0,totalRevenue:0,cogs:0,expensesTotal:0,netProfit:0,inventoryCapital:0,capitalBalance:0,reserveBalance:0});
  return {perSeason, totals, computedAt:Date.now()};
}

