// Loads all data scoped to a given season id (used on normal load + season switch)
async function loadSeasonData(seasonId){
  const sk = (base)=> base + '::' + seasonId;
  try{ const p = await window.storage.get(sk('products-list'), false); PRODUCTS = p ? JSON.parse(p.value) : []; }catch(e){ PRODUCTS = []; }
  try{ const o = await window.storage.get(sk('orders-list'), false); ORDERS = o ? JSON.parse(o.value) : []; }catch(e){ ORDERS = []; }
  migrateLegacyOrderStatuses();
  try{ const ex = await window.storage.get(sk('expenses-list'), false); EXPENSES = ex ? JSON.parse(ex.value) : []; }catch(e){ EXPENSES = []; }
  try{ const pt = await window.storage.get(sk('partners-list'), false); PARTNERS = pt ? JSON.parse(pt.value) : []; }catch(e){ PARTNERS = []; }
  if(PARTNERS.length===0){ PARTNERS = [{id:uid('ptn'), name:'المالك', sharePct:100, dueBalance:0}]; }
  try{ const cl = await window.storage.get(sk('capital-log'), false); CAPITAL_LOG = cl ? JSON.parse(cl.value) : []; }catch(e){ CAPITAL_LOG = []; }
  try{ const rl = await window.storage.get(sk('reserve-log'), false); RESERVE_LOG = rl ? JSON.parse(rl.value) : []; }catch(e){ RESERVE_LOG = []; }
  try{ const pp = await window.storage.get(sk('partner-payouts'), false); PARTNER_PAYOUTS = pp ? JSON.parse(pp.value) : []; }catch(e){ PARTNER_PAYOUTS = []; }
  try{ const st = await window.storage.get(sk('settlements-list'), false); SETTLEMENTS = st ? JSON.parse(st.value) : []; }catch(e){ SETTLEMENTS = []; }
  try{ const rs = await window.storage.get(sk('restock-log'), false); RESTOCK_LOG = rs ? JSON.parse(rs.value) : []; }catch(e){ RESTOCK_LOG = []; }
  try{ const fc = await window.storage.get(sk('finance-config'), false); FINANCE = fc ? JSON.parse(fc.value) : null; }catch(e){ FINANCE = null; }
  ensureDefaultFinance();
  CART = [];
}

function ensureDefaultFinance(){
  if(!FINANCE){
    FINANCE = {
      capitalBalance: 0,
      reserveBalance: 0,
      splitReinvestPct: 50,
      splitOwnerPct: 40,
      splitReservePct: 10,
      lastSettlementAt: null
    };
  }
}

function migrateLegacyOrderStatuses(){
  let migrated = false;
  ORDERS.forEach(o=>{
    if(o.status!=='delivering' && o.status!=='done' && o.status!=='cancelled'){
      o.status = 'delivering';
      migrated = true;
    }
  });
  if(migrated) saveOrders();
}

async function saveAllCurrentSeasonData(){
  await Promise.all([
    saveProducts(), saveOrders(), saveExpenses(), savePartners(), saveCapitalLog(),
    saveReserveLog(), savePartnerPayouts(), saveSettlements(), saveRestockLog(), saveFinanceConfig()
  ]);
}

