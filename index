const EXPENSE_CATEGORIES = ['ترويج وتسويق','إيجار','رواتب','فواتير وخدمات','صيانة','نقل وتوصيل','أخرى'];

function formatDate(ts){
  if(!ts) return '';
  return new Date(ts).toLocaleDateString('en-GB');
}

// Revenue is recognized when an order is marked "done" (delivered & paid).
// COGS uses the wholesalePrice snapshotted on the order item at sale time,
// so later edits to a product's cost don't distort historical profit.
function computeStatsForData(ordersArr, expensesArr, sinceTs){
  const doneOrders = ordersArr.filter(o=> o.status==='done' && (o.doneAt||o.createdAt) > sinceTs);
  let revenueGoods=0, deliveryRevenue=0, cogs=0;
  doneOrders.forEach(o=>{
    deliveryRevenue += (o.deliveryFee||0);
    (o.items||[]).forEach(it=>{
      revenueGoods += it.price*it.qty;
      cogs += (it.wholesalePrice||0)*it.qty;
    });
  });
  const periodExpenses = expensesArr.filter(e=> (e.createdAt||0) > sinceTs);
  const expensesTotal = periodExpenses.reduce((s,e)=>s+e.amount,0);
  const totalRevenue = revenueGoods + deliveryRevenue;
  const grossProfit = revenueGoods - cogs;
  const netProfit = grossProfit + deliveryRevenue - expensesTotal;
  const marginPct = totalRevenue>0 ? (netProfit/totalRevenue*100) : 0;
  return {ordersCount:doneOrders.length, revenueGoods, deliveryRevenue, totalRevenue, cogs, expensesTotal, grossProfit, netProfit, marginPct};
}

function computeStatsSince(sinceTs){
  return computeStatsForData(ORDERS, EXPENSES, sinceTs);
}

