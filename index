function removeCartItem(productId){
  CART = CART.filter(c=>c.productId!==productId);
  renderCartModalContent();
  renderCartFab();
}

function changeCartQty(productId, delta){
  const c = CART.find(x=>x.productId===productId);
  const p = PRODUCTS.find(x=>x.id===productId);
  if(!c || !p) return;
  const newQty = c.qty + delta;
  if(newQty <= 0){ CART = CART.filter(x=>x.productId!==productId); }
  else if(newQty > p.qty){ toast('ما في كمية كافية بالمستودع'); return; }
  else { c.qty = newQty; }
  renderCartModalContent();
  renderCartFab();
}

async function checkoutCart(subtotal){
  if(CART.length===0) return;
  const customer = document.getElementById('cCustomer').value.trim();
  const phone = document.getElementById('cPhone').value.trim();
  const address = document.getElementById('cAddress').value.trim();
  const deliveryFee = parseFloat(document.getElementById('cDeliveryFee').value || '0');
  const shippingId = document.getElementById('cShipping').value;

  if(!customer){ toast('اكتب اسم العميل'); return; }
  if(!phone){ toast('اكتب رقم هاتف العميل'); return; }
  if(!address){ toast('اكتب عنوان العميل'); return; }
  if(isNaN(deliveryFee) || deliveryFee<0){ toast('أجور التوصيل غير صحيحة'); return; }
  if(SHIPPING_COMPANIES.length>0 && !shippingId){ toast('اختر شركة الشحن'); return; }

  const shippingCompany = shippingId ? SHIPPING_COMPANIES.find(c=>c.id===shippingId) : null;

  const items = [];
  let itemsTotal = 0;
  for(const c of CART){
    const p = PRODUCTS.find(x=>x.id===c.productId);
    if(!p || p.qty < c.qty){ toast('في تعارض بالكمية، حاول مجددًا'); return; }
  }
  for(const c of CART){
    const p = PRODUCTS.find(x=>x.id===c.productId);
    p.qty -= c.qty;
    items.push({productId:p.id, name:p.name, price:p.price, wholesalePrice:p.wholesalePrice||0, qty:c.qty});
    itemsTotal += p.price * c.qty;
  }
  ORDERS.push({
    id: uid('ord'), items,
    subtotal: itemsTotal, deliveryFee, total: itemsTotal + deliveryFee,
    status:'delivering',
    customer, phone, address,
    shippingCompanyId: shippingCompany ? shippingCompany.id : null,
    shippingCompanyName: shippingCompany ? shippingCompany.name : '',
    shippingCompanyPhone: shippingCompany ? shippingCompany.phone : '',
    createdAt: Date.now()
  });
  CART = [];
  await saveProducts();
  await saveOrders();
  closeModal();
  toast('تم تنفيذ عملية البيع، الطلب بطريقه للتوصيل 🚚');
  render();
}

