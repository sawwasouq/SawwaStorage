// ---------- seasons (isolated warehouses: season 1, 2, 3...) ----------
function openSeasonModal(){
  const modalRoot = document.getElementById('modalRoot');
  const rows = [...SEASONS].sort((a,b)=>a.createdAt-b.createdAt).map(s=>{
    const isActive = s.id===currentSeasonId;
    return `
    <div class="list-row">
      <div class="lr-main">
        <div class="lr-title">${escapeHtml(s.name)} ${isActive ? '<span class="cat-badge" style="background:#DCEBDD; color:var(--green);">الحالي</span>' : ''}</div>
        <div class="lr-sub">أُنشئ بتاريخ ${formatDate(s.createdAt)}</div>
      </div>
      <div class="lr-actions">
        ${!isActive ? `<button class="btn btn-primary btn-sm" onclick="switchSeason('${s.id}')">تبديل</button>` : ''}
        <button class="icon-btn" onclick="openRenameSeasonModal('${s.id}')" title="إعادة تسمية">✎</button>
        ${SEASONS.length>1 ? `<button class="icon-btn" onclick="deleteSeason('${s.id}')" title="حذف">🗑</button>` : ''}
      </div>
    </div>`;
  }).join('');
  modalRoot.innerHTML = `
  <div class="overlay" onclick="if(event.target===this) closeModal()">
    <div class="modal">
      <h2>المواسم</h2>
      <div class="fin-sub">كل موسم مستودع مستقل تمامًا: منتجاته وطلباته وحساباته منفصلة عن باقي المواسم</div>
      <div style="margin:14px 0;">${rows}</div>
      <div class="field">
        <label>اسم الموسم الجديد</label>
        <input type="text" id="newSeasonName" placeholder="مثال: ${suggestSeasonName()}">
      </div>
      <div class="modal-actions">
        <button class="btn btn-amber btn-block" onclick="submitNewSeason()">+ إنشاء موسم جديد</button>
      </div>
      <div style="margin-top:8px; text-align:center;"><button class="btn btn-ghost btn-sm" onclick="closeModal()">إغلاق</button></div>
    </div>
  </div>`;
}

function suggestSeasonName(){
  const arNums = ['الأول','الثاني','الثالث','الرابع','الخامس','السادس','السابع','الثامن','التاسع','العاشر'];
  const n = SEASONS.length; // next season index (0-based -> n is next ordinal-1)
  return 'الموسم ' + (arNums[n] || ('رقم '+(n+1)));
}

async function submitNewSeason(){
  const input = document.getElementById('newSeasonName');
  const name = (input.value.trim()) || suggestSeasonName();
  const season = {id:uid('season'), name, createdAt:Date.now()};
  SEASONS.push(season);
  await saveSeasonsList();
  allSeasonsSummaryCache = null;
  toast(`تم إنشاء "${name}"`);
  await switchSeason(season.id);
}

function openRenameSeasonModal(seasonId){
  const s = SEASONS.find(x=>x.id===seasonId);
  if(!s) return;
  const modalRoot = document.getElementById('modalRoot');
  modalRoot.innerHTML = `
  <div class="overlay" onclick="if(event.target===this) closeModal()">
    <div class="modal">
      <h2>إعادة تسمية الموسم</h2>
      <div class="field">
        <label>الاسم *</label>
        <input type="text" id="renameSeasonInput" value="${escapeHtml(s.name)}">
      </div>
      <div class="modal-actions">
        <button class="btn btn-primary btn-block" onclick="saveSeasonRename('${s.id}')">حفظ</button>
      </div>
      <div style="margin-top:8px; text-align:center;"><button class="btn btn-ghost btn-sm" onclick="openSeasonModal()">رجوع</button></div>
    </div>
  </div>`;
}

async function saveSeasonRename(seasonId){
  const s = SEASONS.find(x=>x.id===seasonId);
  const name = document.getElementById('renameSeasonInput').value.trim();
  if(!name){ toast('اكتب اسم الموسم'); return; }
  s.name = name;
  await saveSeasonsList();
  if(seasonId===currentSeasonId) updateSeasonLabel();
  toast('تم الحفظ');
  openSeasonModal();
}

async function switchSeason(seasonId){
  if(seasonId===currentSeasonId) return;
  currentSeasonId = seasonId;
  await saveAppSettings();
  await loadSeasonData(seasonId);
  productSearchQuery = '';
  orderFilter = 'all';
  reportPeriod = 'today';
  const searchInput = document.getElementById('productSearch');
  if(searchInput) searchInput.value = '';
  closeModal();
  switchTab('products');
  render();
  toast(`تم التبديل إلى ${SEASONS.find(s=>s.id===seasonId).name}`);
}

async function deleteSeason(seasonId){
  if(SEASONS.length<=1){ toast('لازم يبقى موسم واحد على الأقل'); return; }
  const s = SEASONS.find(x=>x.id===seasonId);
  if(!confirm(`حذف "${s.name}" نهائيًا؟ رح تنحذف كل منتجاته وطلباته وحساباته بدون رجعة.`)) return;
  const sk = (base)=> base + '::' + seasonId;
  const keys = ['products-list','orders-list','expenses-list','partners-list','capital-log','reserve-log','partner-payouts','settlements-list','restock-log','finance-config'];
  for(const k of keys){
    try{ await window.storage.delete(sk(k), false); }catch(e){ /* key may not exist, ignore */ }
  }
  SEASONS = SEASONS.filter(x=>x.id!==seasonId);
  await saveSeasonsList();
  allSeasonsSummaryCache = null;
  if(seasonId===currentSeasonId){
    await switchSeason(SEASONS[0].id);
  } else {
    openSeasonModal();
  }
}

function updateSeasonLabel(){
  const el = document.getElementById('currentSeasonLabel');
  const s = SEASONS.find(x=>x.id===currentSeasonId);
  if(el && s) el.textContent = s.name;
}

function uid(prefix){ return prefix + '_' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
function money(n){ return Number(n).toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2}); }
function toast(msg){
  const t = document.createElement('div');
  t.className='toast'; t.textContent=msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(), 2200);
}

// ---------- tabs ----------
function switchTab(tab){
  currentTab = tab;
  document.getElementById('productsView').style.display = tab==='products' ? 'block':'none';
  document.getElementById('ordersView').style.display = tab==='orders' ? 'block':'none';
  document.getElementById('financeView').style.display = tab==='finance' ? 'block':'none';
  document.getElementById('tabProductsBtn').classList.toggle('active', tab==='products');
  document.getElementById('tabOrdersBtn').classList.toggle('active', tab==='orders');
  document.getElementById('tabFinanceBtn').classList.toggle('active', tab==='finance');
  if(tab==='finance') renderFinance();
}

// ---------- render ----------
function render(){
  updateSeasonLabel();
  renderProductsStats();
  renderLowStockBanner();
  renderProducts();
  renderOrderFilters();
  renderOrdersStats();
  renderOrders();
  renderCartFab();
  renderFinance();
  document.getElementById('countProducts').textContent = PRODUCTS.length;
  document.getElementById('countOrders').textContent = ORDERS.filter(o=>o.status!=='cancelled').length;
}

function renderLowStockBanner(){
  const el = document.getElementById('lowStockBanner');
  if(!el) return;
  const zero = PRODUCTS.filter(p=>p.qty===0);
  const low = PRODUCTS.filter(p=>p.qty>0 && p.qty<=3);
  if(zero.length===0 && low.length===0){ el.innerHTML=''; return; }
  const parts = [];
  if(zero.length) parts.push(`نافذ من المخزون: ${zero.map(p=>escapeHtml(p.name)).join('، ')}`);
  if(low.length) parts.push(`كمية منخفضة: ${low.map(p=>escapeHtml(p.name)).join('، ')}`);
  el.innerHTML = `<div style="background:#F3DCC9; border:1px solid var(--rust); border-radius:10px; padding:10px 14px; margin-bottom:14px; font-size:13px; color:var(--rust); font-weight:700;">
    ⚠️ ${parts.join(' — ')}
  </div>`;
}

function handleProductSearch(val){
  productSearchQuery = val.trim().toLowerCase();
  renderProducts();
}

function renderProductsStats(){
  const el = document.getElementById('productsStats');
  if(!el) return;
  const totalQty = PRODUCTS.reduce((s,p)=>s+p.qty,0);
  const lowStock = PRODUCTS.filter(p=>p.qty>0 && p.qty<=3).length;
  const outOfStock = PRODUCTS.filter(p=>p.qty===0).length;
  const totalValue = PRODUCTS.reduce((s,p)=>s+p.qty*p.price,0);
  const expectedProfit = PRODUCTS.reduce((s,p)=>s+p.qty*(p.price-(p.wholesalePrice||0)),0);
  el.innerHTML = `
    <div class="stat-card"><div class="n">${PRODUCTS.length}</div><div class="l">منتج</div></div>
    <div class="stat-card"><div class="n">${totalQty}</div><div class="l">قطعة بالمستودع</div></div>
    <div class="stat-card"><div class="n">${money(totalValue)}</div><div class="l">قيمة المخزون بسعر البيع (د.أ)</div></div>
    <div class="stat-card"><div class="n">${money(expectedProfit)}</div><div class="l">الربح المتوقع (د.أ)</div></div>
    ${lowStock>0 ? `<div class="stat-card warn"><div class="n">${lowStock}</div><div class="l">كمية منخفضة</div></div>` : ''}
    ${outOfStock>0 ? `<div class="stat-card warn"><div class="n">${outOfStock}</div><div class="l">نافذ من المخزون</div></div>` : ''}
  `;
}

function renderOrderFilters(){
  const el = document.getElementById('orderFilters');
  if(!el) return;
  const counts = {
    all: ORDERS.length,
    delivering: ORDERS.filter(o=>o.status==='delivering').length,
    done: ORDERS.filter(o=>o.status==='done').length,
    cancelled: ORDERS.filter(o=>o.status==='cancelled').length
  };
  const chips = [
    ['all','الكل'], ['delivering','قيد التوصيل'], ['done','تم التسليم'], ['cancelled','ملغي']
  ];
  el.innerHTML = chips.map(([key,label])=>`
    <button class="chip ${orderFilter===key?'active':''}" onclick="setOrderFilter('${key}')">${label}<span class="c">${counts[key]}</span></button>
  `).join('');
}

function setOrderFilter(f){
  orderFilter = f;
  renderOrderFilters();
  renderOrders();
}

function renderOrdersStats(){
  const el = document.getElementById('ordersStats');
  if(!el) return;
  const delivering = ORDERS.filter(o=>o.status==='delivering').length;
  const doneOrders = ORDERS.filter(o=>o.status==='done');
  const revenue = doneOrders.reduce((s,o)=>s+o.total,0);
  el.innerHTML = `
    <div class="stat-card"><div class="n">${delivering}</div><div class="l">طلب قيد التوصيل</div></div>
    <div class="stat-card"><div class="n">${doneOrders.length}</div><div class="l">طلب مُسلَّم</div></div>
    <div class="stat-card"><div class="n">${money(revenue)}</div><div class="l">إجمالي مبيعات مُسلَّمة (د.أ)</div></div>
  `;
}

function renderProducts(){
  const grid = document.getElementById('productsGrid');
  if(PRODUCTS.length===0){
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1">
      <div class="big">📦</div>
      <div style="font-weight:700; margin-bottom:4px;">المستودع فاضي</div>
      <div style="font-size:13px;">ابدأ بإضافة أول منتج عندك</div>
    </div>`;
    return;
  }
  const filtered = productSearchQuery
    ? PRODUCTS.filter(p=>p.name.toLowerCase().includes(productSearchQuery))
    : PRODUCTS;
  if(filtered.length===0){
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1">
